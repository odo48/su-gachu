# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server-only, fără NEXT_PUBLIC_)
GEMINI_API_KEY=

# Claude (server-only, fără NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Groq (STT) — server-only
GROQ_API_KEY=

# ElevenLabs (TTS) — server-only
ELEVENLABS_API_KEY=

# Home Assistant, Ultrahuman and Enable Banking are per-user — connected
# from the UI, not env vars.

# Gmail (email-derived signals) — app-wide OAuth client, one Google Cloud
# project with the Gmail API enabled. Each user still does their own
# consent; only this client id/secret is shared. See supabase/
# 20260830_gmail_connections.sql and src/lib/gmail/client.ts.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# Tavily (web search) — app-wide, available to every agent as a "general"
# tool (see src/lib/mcp/tavily.ts). Leave TAVILY_MCP_URL unset to use
# Tavily's default remote MCP endpoint.
TAVILY_API_KEY=
TAVILY_MCP_URL=

# Optional. If unset, POST /api/garmin/webhook returns 401 (Health API push).
GARMIN_WEBHOOK_SECRET=
