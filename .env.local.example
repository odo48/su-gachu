# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server-only, fără NEXT_PUBLIC_)
GEMINI_API_KEY=

# Claude (server-only, fără NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Garmin Health API (oficial, după aprobare parteneriat) — nefolosit.
# Login-ul Garmin Connect e per-user pe /profile, nu prin env vars.
# GARMIN_CONSUMER_KEY=
# GARMIN_CONSUMER_SECRET=

# Groq (STT) — server-only
GROQ_API_KEY=

# ElevenLabs (TTS) — server-only
ELEVENLABS_API_KEY=

# Enable Banking — app-level credentials (NOT per-user; see
# src/lib/enable-banking/jwt.ts). One private key/app ID per deployment.
ENABLE_BANKING_URL=
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=

# Home Assistant and Ultrahuman are per-user — connected via
# /api/home-assistant/connection and /api/biometrics/connection, not env vars.

# Tavily (web search) — app-wide, available to every agent as a "general"
# tool (see src/lib/mcp/tavily.ts). Leave TAVILY_MCP_URL unset to use
# Tavily's default remote MCP endpoint.
TAVILY_API_KEY=
TAVILY_MCP_URL=
