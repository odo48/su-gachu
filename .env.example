# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # NUMAI server-side — nu expune în browser

# ── Gemini (recomandări zilnice) ───────────────────────────────
GEMINI_API_KEY=AIza...

# ── jarvis-brain (chat / voice) ────────────────────────────────
BRAIN_URL=http://localhost:5000    # URL-ul serviciului Python (local sau deployed)

# ── MCP auth (shared secret între Next.js și jarvis-brain) ────
MCP_SECRET=change-me-to-a-strong-random-secret

# ── Single-user setup (ID-ul tău din Supabase auth.users) ─────
# Folosit de MCP endpoint pentru a ști al cui profil/date să acceseze
BRAIN_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Garmin sync (via jarvis-brain + garth, fără parteneriat) ──
# Credențialele se pun în jarvis-brain/.env, nu aici.
# Su Gachu face proxy spre brain la /api/garmin/sync.
